# Local defaults. Change ADD_API_TOKEN before exposing the API beyond localhost.
ADD_API_TOKEN=change-me

# Optional Home Assistant outbound webhook.
HA_WEBHOOK_URL=
HA_WEBHOOK_TOKEN=
HA_CONTEXT_URL=

# Optional OpenAI-compatible LLM gateway configuration.
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_CREDENTIAL_PROVIDER=llm
