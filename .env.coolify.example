# Coolify environment for https://add.7rb.nl.
# Set these values in Coolify; do not commit the real secrets.
API_CORS_ORIGINS=https://add.7rb.nl
NEXT_PUBLIC_API_URL=https://add.7rb.nl
POSTGRES_DB=add
POSTGRES_USER=add
POSTGRES_PASSWORD=replace-with-a-database-password
ADD_API_TOKEN=replace-with-a-long-random-token
LOCAL_LOGIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-session-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
SECURE_COOKIES=true

# Optional integrations.
HA_WEBHOOK_URL=
HA_WEBHOOK_TOKEN=
HA_CONTEXT_URL=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_CREDENTIAL_PROVIDER=llm
